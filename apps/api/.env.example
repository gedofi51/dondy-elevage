# Pour lancer apps/api directement sur l'hôte (hors Docker), en pointant vers
# le MySQL/Redis dockerisés via leurs ports hôte publiés (voir ../../.env.example
# pour la variante "réseau Docker interne", utilisée par docker-compose.dev.yml).
DATABASE_URL="mysql://dondy_user:change_me_dev_password@localhost:3307/dondy_elevage"
# Le mot de passe doit correspondre à MYSQL_PASSWORD dans ../../.env (utilisé
# pour initialiser le conteneur MySQL de docker-compose.dev.yml).
PORT=3000
# Port web canonique du projet = 3001 (voir CLAUDE.md). Ajuster ici si un
# autre processus occupe déjà ce port sur votre machine (voir le README de
# Phase 0, section Risques, pour un exemple réel rencontré en développement).
CORS_ORIGINS="http://localhost:3001"

JWT_ACCESS_SECRET=change_me_generate_a_strong_random_secret
JWT_REFRESH_SECRET=change_me_generate_a_strong_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
