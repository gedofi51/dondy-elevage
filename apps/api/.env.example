# Pour lancer apps/api directement sur l'hôte (hors Docker), en pointant vers
# le MySQL/Redis/Mailpit dockerisés via leurs ports hôte publiés (voir
# ../../.env.example pour la variante "réseau Docker interne", utilisée par
# docker-compose.dev.yml).
# allowPublicKeyRetrieval=true : requis en DEV UNIQUEMENT pour
# l'authentification caching_sha2_password de MySQL 8.4 sans TLS (échange de
# clé RSA côté client — sans ce paramètre, chaque connexion échoue avec "RSA
# public key is not available client side", masqué en pratique par un
# "pool timeout" en aval, voir DETTE_TECHNIQUE.md). Ne JAMAIS reproduire ce
# paramètre dans une configuration de production : une vraie configuration
# TLS (certificat serveur + `sslmode`/`ssl-mode` côté client) le remplace.
DATABASE_URL="mysql://dondy_user:change_me_dev_password@localhost:3307/dondy_elevage?allowPublicKeyRetrieval=true"
# Le mot de passe doit correspondre à MYSQL_PASSWORD dans ../../.env (utilisé
# pour initialiser le conteneur MySQL de docker-compose.dev.yml).
PORT=3000
CORS_ORIGINS="http://localhost:3001"

APP_URL="http://localhost:3001"
API_URL="http://localhost:3011"

JWT_ACCESS_SECRET=change_me_generate_a_strong_random_secret
JWT_REFRESH_SECRET=change_me_generate_a_strong_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Secret distinct de JWT_ACCESS_SECRET : un token de challenge 2FA compromis
# ne doit jamais pouvoir être réutilisé comme un access token, et inversement.
TWO_FACTOR_CHALLENGE_SECRET=change_me_generate_a_strong_random_secret

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_CALLBACK_URL="http://localhost:3011/api/v1/auth/oauth/google/callback"
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_CALLBACK_URL="http://localhost:3011/api/v1/auth/oauth/microsoft/callback"

SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="DONDY ELEVAGE <no-reply@dondy-elevage.cf>"

# Bootstrap local/dev uniquement — amorce le tout premier compte Super Admin
# (voir prisma/seed.ts). Laisser SEED_SUPER_ADMIN_PASSWORD vide pour ne créer
# aucun compte de bootstrap (comportement par défaut, sûr en production).
SEED_SUPER_ADMIN_EMAIL="superadmin@dondy-elevage.cf"
SEED_SUPER_ADMIN_PASSWORD=

# Taille max d'un document téléversé (Mo) — apps/api/storage/documents/, non
# committé (voir .gitignore). Chemin lui-même non paramétrable : toujours
# relatif à apps/api, identique dans tous les modes d'exécution.
DOCUMENTS_MAX_UPLOAD_SIZE_MB=10
