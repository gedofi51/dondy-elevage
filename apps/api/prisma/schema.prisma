// Schéma Prisma — socle (Phase 0-2) + premier module métier (Phase 3,
// poulets de chair). Toute table métier porte farmId (isolation multi-tenant).

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 : l'URL de connexion n'est plus déclarée ici mais dans
// prisma.config.ts (CLI/Migrate) et passée explicitement au driver adapter
// lors de l'instanciation de PrismaClient (voir src/prisma/prisma.service.ts).
datasource db {
  provider = "mysql"
}

enum UserStatus {
  /// Compte créé par un admin, en attente d'activation (email non vérifié,
  /// aucun mot de passe défini) — voir POST /users puis POST /auth/activer-compte.
  INVITED
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OauthProvider {
  GOOGLE
  MICROSOFT
}

model Farm {
  id       String  @id @default(uuid())
  name     String
  country  String  @default("CF")
  locality String?
  currency String  @default("XAF")
  timezone String  @default("Africa/Bangui")
  settings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  roles               Role[]
  buildings           Building[]
  auditLogs           AuditLog[]
  settingsEntries     Setting[]
  suppliers           Supplier[]
  customers           Customer[]
  documents           Document[]
  alerts              Alert[]
  notifications       Notification[]
  broilerBatches      BroilerBatch[]
  broilerDailyRecords BroilerDailyRecord[]
  broilerMortalities  BroilerMortality[]
  broilerHealthEvents BroilerHealthEvent[]
  expenses            Expense[]
  sales               Sale[]
  payments            Payment[]
  layerBatches        LayerBatch[]
  layerDailyRecords   LayerDailyRecord[]
  layerHealthEvents   LayerHealthEvent[]
  eggStockLots        EggStockLot[]
  eggStockMovements   EggStockMovement[]
  incubators          Incubator[]
  breederBatches      BreederBatch[]
  breederDailyRecords BreederDailyRecord[]
  incubationBatches   IncubationBatch[]
  chickBatches        ChickBatch[]
  batchLineageRows    BatchLineage[]
  waterPoints         WaterPoint[]
  waterReadings       WaterReading[]
  items               Item[]
  stockMovements      StockMovement[]
  purchaseOrders      PurchaseOrder[]
  purchaseOrderItems  PurchaseOrderItem[]
  goodsReceipts       GoodsReceipt[]
  goodsReceiptItems   GoodsReceiptItem[]
  supplierPayments    SupplierPayment[]

  @@map("farms")
}

model User {
  id     String @id @default(uuid())
  farmId String
  email  String
  name   String

  /// Null tant que le compte n'est pas activé (créé par un admin, voir
  /// UserStatus.INVITED) — jamais de mot de passe placeholder inutilisable.
  passwordHash String?
  status       UserStatus @default(INVITED)

  emailVerified              Boolean   @default(false)
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  passwordResetTokenHash     String?
  passwordResetExpiresAt     DateTime?

  twoFactorEnabled Boolean @default(false)
  /// Généré à l'activation 2FA, non utilisé tant que twoFactorEnabled = false.
  twoFactorSecret  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  farm                           Farm                 @relation(fields: [farmId], references: [id])
  userRoles                      UserRole[]
  refreshTokens                  RefreshToken[]
  oauthAccounts                  OauthAccount[]
  auditLogs                      AuditLog[]           @relation("AuditLogUser")
  notifications                  Notification[]
  broilerBatchesAsPrimaryManager BroilerBatch[]       @relation("BroilerBatchPrimaryManager")
  dailyRecordsAsOperator         BroilerDailyRecord[] @relation("BroilerDailyRecordOperator")
  salesAsSeller                  Sale[]               @relation("SaleSeller")
  layerBatchesAsPrimaryManager   LayerBatch[]         @relation("LayerBatchPrimaryManager")
  dailyRecordsAsLayerOperator    LayerDailyRecord[]   @relation("LayerDailyRecordOperator")
  breederBatchesAsPrimaryManager BreederBatch[]       @relation("BreederBatchPrimaryManager")
  dailyRecordsAsBreederOperator  BreederDailyRecord[] @relation("BreederDailyRecordOperator")
  waterPointsAsResponsible       WaterPoint[]         @relation("WaterPointResponsible")
  waterReadingsAsOperator        WaterReading[]       @relation("WaterReadingOperator")
  goodsReceiptsAsResponsible     GoodsReceipt[]       @relation("GoodsReceiptResponsible")

  @@unique([farmId, email])
  @@index([farmId])
  @@map("users")
}

/// RBAC piloté par données : les rôles/permissions ne sont jamais un enum figé
/// dans le code, pour absorber les référentiels de rôles à unifier (voir
/// docs/architecture/DONDY_ELEVAGE_GO_PHASE0.md, point B.5).
model Role {
  id       String  @id @default(uuid())
  /// null = rôle système global (isSystem = true) ; renseigné = rôle propre à une ferme
  farmId   String?
  name     String
  isSystem Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  farm            Farm?            @relation(fields: [farmId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([farmId, name])
  @@index([farmId])
  @@map("roles")
}

/// Catalogue système des permissions, non scindé par ferme.
model Permission {
  id          String  @id @default(uuid())
  code        String  @unique
  description String?

  createdAt DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  createdAt DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id                  String    @id @default(uuid())
  userId              String
  tokenHash           String
  expiresAt           DateTime
  revokedAt           DateTime?
  /// Renseigné à la rotation : hash du token émis en remplacement de celui-ci.
  /// Un refresh révoqué mais réutilisé (replacedByTokenHash déjà renseigné)
  /// indique un vol probable — toute la famille de tokens est alors révoquée.
  replacedByTokenHash String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model OauthAccount {
  id                String        @id @default(uuid())
  userId            String
  provider          OauthProvider
  providerAccountId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Building {
  id       String @id @default(uuid())
  farmId   String
  name     String
  type     String
  capacity Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  farm           Farm           @relation(fields: [farmId], references: [id])
  broilerBatches BroilerBatch[]
  layerBatches   LayerBatch[]
  breederBatches BreederBatch[]
  chickBatches   ChickBatch[]

  @@index([farmId])
  @@map("buildings")
}

/// Append-only par convention applicative : jamais de mise à jour du contenu
/// d'une entrée existante. `deletedAt` reste présent pour rester conforme à la
/// convention transversale (finances/santé/audit), réservé à un usage
/// administratif exceptionnel — jamais utilisé par le flux applicatif normal.
model AuditLog {
  id         String  @id @default(uuid())
  farmId     String
  userId     String?
  entityType String
  entityId   String
  action     String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  farm Farm  @relation(fields: [farmId], references: [id])
  user User? @relation("AuditLogUser", fields: [userId], references: [id])

  @@index([farmId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Setting {
  id     String @id @default(uuid())
  farmId String
  key    String
  value  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm Farm @relation(fields: [farmId], references: [id])

  @@unique([farmId, key])
  @@map("settings")
}

/// Donnée de référence (comme Building) : suppression définitive, tracée par
/// AuditLog (oldValues), pas de deletedAt — voir docs/reference/BASE_DE-DONNEES.md,
/// le soft delete est réservé aux données financières/sanitaires/d'audit.
model Supplier {
  id          String  @id @default(uuid())
  farmId      String
  name        String
  /// Catégorie paramétrable : texte libre, volontairement pas un enum figé.
  category    String
  contactName String?
  phone       String?
  address     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  farm           Farm            @relation(fields: [farmId], references: [id])
  broilerBatches BroilerBatch[]
  expenses       Expense[]
  items          Item[]
  purchaseOrders PurchaseOrder[]

  @@index([farmId])
  @@map("suppliers")
}

enum CustomerType {
  PARTICULIER
  COMMERCANT
  RESTAURANT
  REVENDEUR
  ENTREPRISE
  AUTRE
}

/// Donnée de référence (comme Building) : suppression définitive, tracée par
/// AuditLog (oldValues), pas de deletedAt.
model Customer {
  id           String       @id @default(uuid())
  farmId       String
  /// Auto-généré (ex. "CLI-000123"), dérivé du dernier code émis — voir
  /// CustomersService.generateCode().
  code         String
  /// Couvre "nom/prénom ou raison sociale" en un seul champ libre — `type`
  /// distingue déjà particulier vs entreprise.
  name         String
  phone        String?
  locality     String?
  address      String?
  type         CustomerType @default(AUTRE)
  observations String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  farm  Farm   @relation(fields: [farmId], references: [id])
  sales Sale[]

  @@unique([farmId, code])
  @@index([farmId])
  @@map("customers")
}

/// Rattachement polymorphe (entityType + entityId, pas de FK Prisma — la
/// cible varie). deletedAt conservé ici (contrairement à Supplier/Customer) :
/// contrairement à une ligne de données, les octets du fichier ne sont
/// reconstructibles depuis aucune autre trace — suppression physique jamais
/// effectuée sur ce chemin, seulement soft-delete de la ligne.
model Document {
  id           String  @id @default(uuid())
  farmId       String
  entityType   String
  entityId     String
  /// Catégorie paramétrable (facture, photo, ordonnance, certificat...),
  /// texte libre comme Supplier.category.
  category     String?
  /// Conservé pour affichage uniquement — JAMAIS utilisé pour construire un
  /// chemin sur disque (voir storedName).
  originalName String
  /// Nom UUID réel sur disque, extension dérivée du MIME validé par contenu
  /// (jamais de l'extension fournie par l'utilisateur).
  storedName   String
  mimeType     String
  sizeBytes    Int

  createdAt DateTime  @default(now())
  createdBy String?
  deletedAt DateTime?

  farm Farm @relation(fields: [farmId], references: [id])

  @@index([farmId])
  @@index([entityType, entityId])
  @@map("documents")
}

enum AlertSeverity {
  INFO
  VIGILANCE
  IMPORTANT
  CRITIQUE
}

/// Cycle de vie à 3 états — voir alert-state-machine.ts pour les transitions
/// valides (CREATED -> TRIGGERED -> ACKNOWLEDGED, aucune autre).
enum AlertStatus {
  CREATED
  TRIGGERED
  ACKNOWLEDGED
}

model Alert {
  id             String        @id @default(uuid())
  farmId         String
  /// Code libre (ex. "tache_en_retard") — les futures règles métier
  /// (mortalité, stock...) ajouteront leurs propres types, pas un enum figé.
  type           String
  severity       AlertSeverity
  /// Rattachement polymorphe optionnel : une alerte générique peut ne cibler
  /// aucune entité précise (ex. démo "tâche en retard").
  entityType     String?
  entityId       String?
  title          String
  message        String?       @db.Text
  status         AlertStatus   @default(CREATED)
  scheduledAt    DateTime?
  triggeredAt    DateTime?
  acknowledgedAt DateTime?
  /// Convention createdBy : string simple sans relation Prisma, comme partout
  /// ailleurs dans ce schéma (Building.createdBy, User.createdBy...).
  acknowledgedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm          Farm           @relation(fields: [farmId], references: [id])
  notifications Notification[]

  @@index([farmId])
  @@index([farmId, status])
  @@index([entityType, entityId])
  @@map("alerts")
}

model Notification {
  id      String    @id @default(uuid())
  farmId  String
  userId  String
  alertId String?
  title   String
  message String?   @db.Text
  /// Seul canal cette phase ; champ réservé pour un futur canal email.
  channel String    @default("in_app")
  readAt  DateTime?

  createdAt DateTime @default(now())

  farm  Farm   @relation(fields: [farmId], references: [id])
  user  User   @relation(fields: [userId], references: [id])
  alert Alert? @relation(fields: [alertId], references: [id])

  @@index([farmId])
  @@index([userId, readAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Phase 3 — Poulets de chair (J1-J45)
// ---------------------------------------------------------------------------

enum BroilerOrigin {
  ACHAT
  NAISSANCE_INTERNE
}

enum BroilerBatchStatus {
  BROUILLON
  PLANIFIEE
  EN_DEMARRAGE
  EN_CROISSANCE
  EN_FINITION
  PRETE_A_VENDRE
  EN_VENTE
  VENDUE
  CLOTUREE
  ANNULEE
}

/// Donnée de référence pour l'effectif/le cycle (comme Building) : hard
/// delete, mais uniquement si aucune Expense/Sale/Payment liée (règle
/// appliquée en service, jamais contournée par rôle) — sinon annulation via
/// status=ANNULEE. startedQuantity/chickCostFcfa/totalAcquisitionCostFcfa
/// volontairement NON stockés : calculés à la lecture depuis
/// receivedQuantity/deadOnArrivalQuantity/unitPriceFcfa/... pour ne jamais
/// diverger d'une correction ultérieure de ces champs sources.
model BroilerBatch {
  id     String @id @default(uuid())
  farmId String
  /// Auto-généré, format PC-AAAA-NNN (AAAA = année d'arrivée), dérivé du
  /// dernier code émis pour la ferme+année — voir generateBatchCode().
  code   String

  productionType String  @default("poulet_chair")
  /// Texte libre comme Supplier.category — pas de table Breed cette phase.
  breed          String?

  arrivalDate   DateTime
  arrivalTime   String?
  origin        BroilerOrigin
  supplierId    String?
  invoiceNumber String?

  orderedQuantity       Int
  receivedQuantity      Int
  deadOnArrivalQuantity Int @default(0)

  unitPriceFcfa     Int
  transportCostFcfa Int @default(0)
  otherCostsFcfa    Int @default(0)

  buildingId       String
  primaryManagerId String
  /// Défaut = arrivalDate + 44 jours à la création, modifiable ensuite. Les
  /// jalons calendaires (J1..J46+) restent TOUJOURS calculés depuis
  /// arrivalDate, jamais depuis plannedSaleDate — notions indépendantes.
  plannedSaleDate  DateTime

  status       BroilerBatchStatus @default(BROUILLON)
  observations String?            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  farm           Farm                 @relation(fields: [farmId], references: [id])
  supplier       Supplier?            @relation(fields: [supplierId], references: [id])
  building       Building             @relation(fields: [buildingId], references: [id])
  primaryManager User                 @relation("BroilerBatchPrimaryManager", fields: [primaryManagerId], references: [id])
  dailyRecords   BroilerDailyRecord[]
  mortalities    BroilerMortality[]
  healthEvents   BroilerHealthEvent[]
  expenses       Expense[]
  sales          Sale[]

  @@unique([farmId, code])
  @@index([farmId])
  @@index([farmId, status])
  @@map("broiler_batches")
}

/// Une ligne par jour J1..J45+, générée automatiquement (transaction) à la
/// création de la bande — jamais créée/supprimée manuellement, UPDATE
/// uniquement. mortalityQuantity/cullsQuantity/otherExitsQuantity restent la
/// valeur de référence rapide pour les calculs d'effectif (pas de jointure) ;
/// BroilerMortality est le détail optionnel par cause — toute divergence
/// entre les deux déclenche une alerte de cohérence plutôt que d'être
/// esquivée architecturalement (voir BroilerMortality).
model BroilerDailyRecord {
  id      String @id @default(uuid())
  farmId  String
  batchId String

  dayNumber Int
  date      DateTime

  /// Auto-rempli avec l'utilisateur courant à la saisie. NULL = "journée non
  /// saisie" — signal réutilisé tel quel par le cron d'alerte "absence de
  /// saisie quotidienne" (pas de colonne dédiée supplémentaire).
  operatorId String?
  entryTime  String?

  mortalityQuantity  Int @default(0)
  cullsQuantity      Int @default(0)
  otherExitsQuantity Int @default(0)

  feedType          String?
  feedDistributedKg Decimal? @db.Decimal(8, 2)
  feedRemainingKg   Decimal? @db.Decimal(8, 2)
  feedBagsUsed      Int?
  /// Phase 7 — additif : si renseigné, chaque correction de
  /// feedDistributedKg déclenche un StockMovement SORTIE (delta, pas la
  /// valeur brute) + une Expense sur la bande. NULL = pas de mouvement de
  /// stock automatique (comportement historique inchangé).
  feedItemId        String?

  waterConsumptionLiters Decimal? @db.Decimal(8, 2)
  waterObservation       String?  @db.Text

  sampleSize         Int?
  totalSampleWeightG Int?
  /// Dérivé de totalSampleWeightG/sampleSize à l'écriture (contrairement au
  /// coût d'acquisition de BroilerBatch : ici source et résultat vivent sur
  /// la même ligne immuable du jour, pas de risque de correction rétroactive
  /// d'un champ séparé).
  averageWeightG     Int?

  temperatureMinC Decimal? @db.Decimal(4, 1)
  temperatureMaxC Decimal? @db.Decimal(4, 1)
  temperatureNowC Decimal? @db.Decimal(4, 1)
  humidityPercent Decimal? @db.Decimal(4, 1)

  symptoms          String? @db.Text
  treatment         String? @db.Text
  vaccination       String?
  healthProduct     String?
  healthQuantity    String?
  healthResponsible String?

  behaviorNormal              Boolean @default(false)
  behaviorLowConsumption      Boolean @default(false)
  behaviorAgitation           Boolean @default(false)
  behaviorFlocking            Boolean @default(false)
  behaviorLethargy            Boolean @default(false)
  behaviorDiarrhea            Boolean @default(false)
  behaviorRespiratoryDistress Boolean @default(false)
  behaviorOther               String?

  observations String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm     Farm         @relation(fields: [farmId], references: [id])
  batch    BroilerBatch @relation(fields: [batchId], references: [id])
  operator User?        @relation("BroilerDailyRecordOperator", fields: [operatorId], references: [id])
  feedItem Item?        @relation("BroilerDailyRecordFeedItem", fields: [feedItemId], references: [id])

  @@unique([batchId, dayNumber])
  @@index([farmId])
  @@index([batchId, date])
  @@map("broiler_daily_records")
}

enum MortalityCause {
  INCONNUE
  MALADIE
  ACCIDENT
  ETOUFFEMENT
  CHALEUR
  FROID
  PROBLEME_ALIMENTAIRE
  PROBLEME_EAU
  PREDATEUR
  AUTRE
}

/// Enum fixe (contrairement à Expense.category/Payment.method) : le cahier
/// des charges ne qualifie jamais cette liste de "paramétrable", contrairement
/// à Supplier.category — signal explicite retenu tel quel.
/// deletedAt : donnée sanitaire, pas de suppression définitive (voir
/// docs/reference/BASE_DE-DONNEES.md).
model BroilerMortality {
  id      String @id @default(uuid())
  farmId  String
  batchId String

  date        DateTime
  dayNumber   Int
  quantity    Int
  cause       MortalityCause @default(INCONNUE)
  observation String?        @db.Text
  recordedBy  String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  farm  Farm         @relation(fields: [farmId], references: [id])
  batch BroilerBatch @relation(fields: [batchId], references: [id])

  @@index([farmId])
  @@index([batchId, date])
  @@map("broiler_mortalities")
}

enum HealthEventType {
  VACCINATION
  TRAITEMENT
  PROPHYLAXIE
  DESINFECTION
  VITAMINE
  CONSULTATION_VETERINAIRE
}

enum HealthEventStatus {
  PREVU
  REALISE
  REPORTE
  ANNULE
}

enum HealthEventRoute {
  EAU
  INJECTION
  AUTRE
}

/// Pas de deletedAt : le statut ANNULE (natif) couvre déjà l'annulation, pas
/// de permission DELETE distincte.
model BroilerHealthEvent {
  id      String @id @default(uuid())
  farmId  String
  batchId String

  date   DateTime
  status HealthEventStatus @default(PREVU)
  type   HealthEventType

  product  String?
  motif    String? @db.Text
  dose     String?
  quantity String?
  unit     String?

  durationDays        Int?
  administrationRoute HealthEventRoute?

  prescribedBy String?
  performedBy  String?
  costFcfa     Int?
  observation  String? @db.Text

  /// Phase 7 — additifs, EN PLUS de product/quantity/unit (texte libre,
  /// conservés tels quels). Quand les deux sont renseignés ET status passe
  /// à REALISE, déclenche un StockMovement SORTIE + une Expense sanitaire.
  /// Jamais sur PREVU (un soin planifié ne doit pas déduire le stock avant
  /// d'être réellement administré).
  itemId       String?
  quantityUsed Decimal? @db.Decimal(12, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  farm  Farm         @relation(fields: [farmId], references: [id])
  batch BroilerBatch @relation(fields: [batchId], references: [id])
  item  Item?        @relation("BroilerHealthEventItem", fields: [itemId], references: [id])

  @@index([farmId])
  @@index([batchId, date])
  @@map("broiler_health_events")
}

/// Donnée financière — deletedAt (pas de suppression définitive, voir
/// docs/reference/BASE_DE-DONNEES.md). batchId nullable : §12.3 du cahier
/// des charges V1 précise qu'une dépense PEUT être affectée à une bande
/// (charges générales de ferme possibles aussi). category en texte libre
/// paramétrable (ex. "aliments" pour le coût alimentation §6.3 — Expense EST
/// déjà le couple quantité×prix=montant générique, pas de mécanisme dédié).
/// batchId (BroilerBatch) et layerBatchId (LayerBatch) désormais tous deux
/// nullables : Expense EST le couple quantité×prix=montant générique
/// (Phase 3, ex. category="aliments") réutilisé tel quel pour les
/// pondeuses (Phase 4) plutôt qu'un mécanisme dédié — voir MODULE_PONTE.md.
model Expense {
  id                String  @id @default(uuid())
  farmId            String
  batchId           String?
  layerBatchId      String?
  /// FK ChickBatch (Phase 5) — coûts rattachables à un lot de poussins
  /// (ex. aliment démarrage avant vente), même généralisation que
  /// layerBatchId en Phase 4.
  chickBatchId      String?
  /// Phase 7 — §8.5 : "les dépenses peuvent être affectées à... un lot
  /// reproducteur, un couvoir, un point d'eau..." — mêmes généralisations
  /// que les FK ci-dessus, complètent la liste explicite du cahier.
  breederBatchId    String?
  incubationBatchId String?
  waterPointId      String?

  date          DateTime
  category      String
  description   String?  @db.Text
  quantity      Decimal? @db.Decimal(10, 2)
  unitPriceFcfa Int?
  amountFcfa    Int
  supplierId    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  farm            Farm             @relation(fields: [farmId], references: [id])
  batch           BroilerBatch?    @relation(fields: [batchId], references: [id])
  layerBatch      LayerBatch?      @relation(fields: [layerBatchId], references: [id])
  chickBatch      ChickBatch?      @relation(fields: [chickBatchId], references: [id])
  breederBatch    BreederBatch?    @relation(fields: [breederBatchId], references: [id])
  incubationBatch IncubationBatch? @relation(fields: [incubationBatchId], references: [id])
  waterPoint      WaterPoint?      @relation(fields: [waterPointId], references: [id])
  supplier        Supplier?        @relation(fields: [supplierId], references: [id])

  @@index([farmId])
  @@index([batchId])
  @@index([layerBatchId])
  @@index([chickBatchId])
  @@index([breederBatchId])
  @@index([incubationBatchId])
  @@index([waterPointId])
  @@map("expenses")
}

enum SaleMode {
  UNITE
  POIDS
  LOT
}

enum SaleStatus {
  BROUILLON
  RESERVEE
  CONFIRMEE
  PAYEE
  PARTIELLEMENT_PAYEE
  IMPAYEE
  ANNULEE
}

/// Phase 4 : distingue quel FK (batchId / layerBatchId) porte la vente —
/// voir décision "généralisation vs duplication" du plan Phase 4. Exactement
/// un des deux FK doit être renseigné selon productType, vérifié en service
/// (pas de CHECK MySQL natif, cohérent avec le reste du code).
enum SaleProductType {
  POULET_CHAIR
  OEUFS
  POUSSINS
  EAU
}

/// Pas de SaleItem : une vente = un lot d'une bande (le cahier §16 propose
/// une table séparée pour un futur multi-bande, mais rien dans le périmètre
/// Phase 3 — formulaire §10.3 et exemple §10.5 — ne le justifie ; §10.5 vend
/// en plusieurs VENTES séparées, pas en lignes d'une même vente). Pas de
/// delete — §17 "interdire la suppression silencieuse d'une vente payée" :
/// seule annulation via status=ANNULEE, bloquée si (PARTIELLEMENT_)PAYEE.
/// Généralisé en Phase 4 (batchId nullable + layerBatchId) plutôt que
/// dupliqué : Payment.saleId pointe déjà dur sur cette table (dupliquer
/// aurait forcé soit à dupliquer tout le module Payments, soit une FK
/// polymorphe, écartée — voir plan Phase 4). Un seul registre VTE-AAAA-NNN
/// partagé entre poulets et œufs, pas de séquence par productType.
model Sale {
  id           String          @id @default(uuid())
  farmId       String
  productType  SaleProductType @default(POULET_CHAIR)
  /// FK BroilerBatch — nullable depuis Phase 4 (renseigné seulement si
  /// productType = POULET_CHAIR).
  batchId      String?
  /// FK LayerBatch — renseigné seulement si productType = OEUFS.
  layerBatchId String?
  /// FK ChickBatch (Phase 5) — renseigné seulement si productType = POUSSINS.
  chickBatchId String?
  /// FK WaterPoint (Phase 6) — renseigné seulement si productType = EAU.
  waterPointId String?
  /// Auto-généré, format VTE-AAAA-NNN, même principe que BroilerBatch.code.
  saleNumber   String

  date       DateTime
  /// Nullable depuis Phase 6 : uniquement pour productType = EAU (vente
  /// comptoir anonyme, §7.4 — "sans création obligatoire de client").
  /// Requis pour POULET_CHAIR/OEUFS/POUSSINS, vérifié en DTO (@ValidateIf)
  /// et en service, pas seulement par la nullabilité de la colonne.
  customerId String?
  sellerId   String

  saleMode SaleMode
  quantity Int
  weightKg Decimal? @db.Decimal(8, 2)

  unitPriceFcfa   Int
  discountFcfa    Int @default(0)
  grossAmountFcfa Int
  netAmountFcfa   Int

  status      SaleStatus @default(BROUILLON)
  observation String?    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  farm              Farm               @relation(fields: [farmId], references: [id])
  batch             BroilerBatch?      @relation(fields: [batchId], references: [id])
  layerBatch        LayerBatch?        @relation(fields: [layerBatchId], references: [id])
  chickBatch        ChickBatch?        @relation(fields: [chickBatchId], references: [id])
  waterPoint        WaterPoint?        @relation(fields: [waterPointId], references: [id])
  customer          Customer?          @relation(fields: [customerId], references: [id])
  seller            User               @relation("SaleSeller", fields: [sellerId], references: [id])
  payments          Payment[]
  eggStockMovements EggStockMovement[]

  @@unique([farmId, saleNumber])
  @@index([farmId])
  @@index([batchId])
  @@index([layerBatchId])
  @@index([chickBatchId])
  @@index([waterPointId])
  @@index([farmId, status])
  @@map("sales")
}

/// Append-only (comme AuditLog) : pas d'updatedAt, correction via deletedAt +
/// recréation, jamais d'édition en place d'un paiement.
model Payment {
  id     String @id @default(uuid())
  farmId String
  saleId String

  date        DateTime
  /// Paramétrable, texte libre — explicitement qualifié "paramétrable" par
  /// le cahier des charges §10.4.
  method      String
  amountFcfa  Int
  reference   String?
  observation String?  @db.Text

  createdAt DateTime  @default(now())
  createdBy String?
  deletedAt DateTime?

  farm Farm @relation(fields: [farmId], references: [id])
  sale Sale @relation(fields: [saleId], references: [id])

  @@index([farmId])
  @@index([saleId])
  @@map("payments")
}

// ============================================================================
// Phase 4 — Pondeuses et production d'œufs (V5 §5)
// ============================================================================

enum LayerBatchStatus {
  ELEVAGE
  PONTE
  REFORME
  CLOTURE
  /// Ajouté au-delà des 4 valeurs du cahier §5.1 : réplique le pattern déjà
  /// établi côté BroilerBatch (remove() bloque le hard-delete dès qu'une
  /// activité financière/sanitaire existe, sinon impose ce statut — jamais
  /// de suppression silencieuse d'une donnée avec activité).
  ANNULEE
}

/// Calqué sur BroilerBatch avec deux écarts assumés : pas de champs de coût
/// d'acquisition (le cahier §5.1 ne les liste pas — un achat de pondeuses
/// passe par Expense, catégorie libre) ; pas de statut BROUILLON (aucune
/// phase de planification avant ELEVAGE décrite dans le cahier, contrairement
/// au poulet qui a un délai achat->arrivée à planifier).
model LayerBatch {
  id     String @id @default(uuid())
  farmId String
  /// Auto-généré, format PON-AAAA-NNN, retry sur conflit P2002 — pattern
  /// CustomersService.generateCode (le plus sûr des deux patterns déjà en
  /// place, contrairement à BroilerBatchesService.generateBatchCode qui n'a
  /// pas de retry).
  code   String

  /// Souche, texte libre comme BroilerBatch.breed.
  strain String?

  entryDate       DateTime
  initialQuantity Int
  ageAtEntryWeeks Int?
  ageAtEntryDays  Int?

  buildingId       String
  primaryManagerId String

  status       LayerBatchStatus @default(ELEVAGE)
  observations String?          @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  farm           Farm               @relation(fields: [farmId], references: [id])
  building       Building           @relation(fields: [buildingId], references: [id])
  primaryManager User               @relation("LayerBatchPrimaryManager", fields: [primaryManagerId], references: [id])
  dailyRecords   LayerDailyRecord[]
  healthEvents   LayerHealthEvent[]
  eggStockLots   EggStockLot[]
  expenses       Expense[]
  sales          Sale[]

  @@unique([farmId, code])
  @@index([farmId])
  @@index([farmId, status])
  @@map("layer_batches")
}

/// Contrairement à BroilerDailyRecord (45 lignes pré-générées, update-only),
/// une ligne par jour créée À LA DEMANDE (pas de durée de cycle fixe pour
/// une pondeuse en production continue). date immuable une fois créée
/// (comme dayNumber côté Broiler), pas de DELETE exposé (correction par
/// PATCH uniquement).
model LayerDailyRecord {
  id      String @id @default(uuid())
  farmId  String
  batchId String

  date       DateTime
  /// Auto-rempli avec l'utilisateur courant à l'écriture. Contrairement au
  /// cron Broiler (operatorId IS NULL sur une ligne pré-générée), l'absence
  /// de saisie côté pondeuses se détecte par ABSENCE DE LIGNE (pas de
  /// placeholder), voir LayerAlertsCronService.
  operatorId String?

  /// Effectif début de journée — §5.2 "calcul + ajustement contrôlé" : le
  /// service suggère (veille - sorties de la veille), le DTO peut fournir une
  /// valeur qui la remplace (recomptage physique). PERSISTÉ (contrairement à
  /// LayerBatch.effectif recalculé à la lecture) : le parallèle correct est
  /// BroilerDailyRecord.averageWeightG (dérivé à l'écriture, stocké sur une
  /// ligne immuable du jour), pas BroilerBatch.currentHeadcount — recalculer
  /// un cumul glissant à chaque lecture d'une liste de mois de lignes serait
  /// bien plus coûteux qu'un stockage direct.
  henCount           Int
  mortalityQuantity  Int @default(0)
  cullsQuantity      Int @default(0)
  otherExitsQuantity Int @default(0)

  eggsLaid     Int
  eggsBroken   Int @default(0)
  eggsRejected Int @default(0)
  /// Dérivé à l'écriture = eggsLaid - eggsBroken - eggsRejected (§5.3).
  eggsSellable Int

  /// Dérivé à l'écriture, safeDivide(eggsLaid, henCount) x 100 (§5.3).
  layingRatePercent Decimal? @db.Decimal(5, 2)
  feedDistributedKg Decimal? @db.Decimal(8, 2)
  /// Phase 7 — additif, même principe que BroilerDailyRecord.feedItemId.
  feedItemId        String?

  observations String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm        Farm         @relation(fields: [farmId], references: [id])
  batch       LayerBatch   @relation(fields: [batchId], references: [id])
  operator    User?        @relation("LayerDailyRecordOperator", fields: [operatorId], references: [id])
  feedItem    Item?        @relation("LayerDailyRecordFeedItem", fields: [feedItemId], references: [id])
  eggStockLot EggStockLot?

  @@unique([batchId, date])
  @@index([farmId])
  @@index([batchId, date])
  @@map("layer_daily_records")
}

/// Dupliqué depuis BroilerHealthEvent (PAS généralisé) — décision tranchée
/// du plan Phase 4 : health-events.service.ts est un CRUD mécanique sans
/// aucune validation de transition d'état, rien de non trivial à partager ;
/// généraliser aurait obligé à toucher un module Phase 3 déjà mergé/testé
/// pour un bénéfice quasi nul. Les enums HealthEventType/Status/Route SONT
/// réutilisés tels quels (déjà génériques) — seule la table est dupliquée.
model LayerHealthEvent {
  id      String @id @default(uuid())
  farmId  String
  batchId String

  date   DateTime
  status HealthEventStatus @default(PREVU)
  type   HealthEventType

  product  String?
  motif    String? @db.Text
  dose     String?
  quantity String?
  unit     String?

  durationDays        Int?
  administrationRoute HealthEventRoute?

  prescribedBy String?
  performedBy  String?
  costFcfa     Int?
  observation  String? @db.Text

  /// Phase 7 — additifs, même principe que BroilerHealthEvent.
  itemId       String?
  quantityUsed Decimal? @db.Decimal(12, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  farm  Farm       @relation(fields: [farmId], references: [id])
  batch LayerBatch @relation(fields: [batchId], references: [id])
  item  Item?      @relation("LayerHealthEventItem", fields: [itemId], references: [id])

  @@index([farmId])
  @@index([batchId, date])
  @@map("layer_health_events")
}

/// 1 lot créé automatiquement par LayerDailyRecord (relation 1:1 explicite
/// via dailyRecordId, pas un rapprochement par date), quantityProduced =
/// eggsSellable du jour, SNAPSHOT PERSISTÉ (contrairement à
/// BroilerBatch.startedQuantity recalculé à la lecture — ici la stabilité du
/// point de départ est nécessaire car des EggStockMovement vont le consommer
/// en FIFO). Pas de lot créé si eggsSellable = 0.
model EggStockLot {
  id            String @id @default(uuid())
  farmId        String
  batchId       String
  dailyRecordId String @unique

  productionDate DateTime
  /// Paramétrable, texte libre comme Supplier.category (le cahier qualifie
  /// explicitement les calibres de "paramétrable"). Fractionnement d'un lot
  /// en plusieurs calibres après coup = hors périmètre V1, aucun workflow de
  /// tri/calibrage décrit dans le cahier.
  caliber        String   @default("non_calibre")

  /// Snapshot persisté — jamais recalculé rétroactivement si le
  /// LayerDailyRecord source est corrigé après coup (voir garde-fou 409 dans
  /// LayerDailyRecordsService.update).
  quantityProduced Int

  createdAt DateTime @default(now())

  farm        Farm               @relation(fields: [farmId], references: [id])
  batch       LayerBatch         @relation(fields: [batchId], references: [id])
  dailyRecord LayerDailyRecord   @relation(fields: [dailyRecordId], references: [id])
  movements   EggStockMovement[]

  @@index([farmId])
  @@index([batchId, productionDate])
  @@map("egg_stock_lots")
}

enum EggStockMovementType {
  SORTIE_VENTE
  /// Compensation d'un SORTIE_VENTE annulé — jamais de suppression/édition
  /// d'un mouvement existant (append-only, symétrique au pattern Payment).
  ENTREE_ANNULATION
  PERTE_CASSE
  PERTE_SOUILLURE
  CONSOMMATION_INTERNE
  DON
  PERTE_AUTRE
}

/// Append-only, comme Payment — jamais d'update/delete. La quantité restante
/// d'un lot n'est jamais une colonne : toujours dérivée à la lecture =
/// quantityProduced - SUM(mouvements sortants) + SUM(ENTREE_ANNULATION).
model EggStockMovement {
  id     String @id @default(uuid())
  farmId String
  lotId  String

  type       EggStockMovementType
  quantity   Int
  date       DateTime
  saleId     String?
  reason     String?              @db.Text
  recordedBy String

  createdAt DateTime @default(now())

  farm Farm        @relation(fields: [farmId], references: [id])
  lot  EggStockLot @relation(fields: [lotId], references: [id])
  sale Sale?       @relation(fields: [saleId], references: [id])

  @@index([farmId])
  @@index([lotId])
  @@index([saleId])
  @@map("egg_stock_movements")
}

// ============================================================================
// Phase 5 — Reproductrices, couvoir et poussins (V5 §6)
// ============================================================================

/// Équipement technique (capacité en œufs), distinct de Building
/// (bâtiment, capacité en animaux) — le modèle cible du cahier V5 §12
/// liste `incubators` séparément de `buildings`, aucune table tierce
/// n'impose de généraliser Building. Donnée de référence : hard delete,
/// pas de deletedAt, comme Supplier/Building.
model Incubator {
  id           String  @id @default(uuid())
  farmId       String
  name         String
  capacityEggs Int?
  notes        String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  farm              Farm              @relation(fields: [farmId], references: [id])
  incubationBatches IncubationBatch[]

  @@index([farmId])
  @@map("incubators")
}

enum BreederBatchStatus {
  ACTIF
  REFORME
  CLOTURE
  /// Ajouté au-delà des 3 valeurs du cahier §6.1 — même soupape de
  /// sécurité qu'en Phase 4 (remove() bloque le hard-delete dès qu'une
  /// activité liée existe, sinon impose ce statut).
  ANNULEE
}

/// Pas de suivi d'effectif journalier (femaleCount/maleCount restent des
/// champs statiques, corrigibles par PATCH) : le cahier §6.2 (production
/// journalière) ne contient aucun champ mortalité/réforme/autres sorties,
/// contrairement à LayerDailyRecord — signal net qu'aucune source de
/// décrément n'existe dans ce périmètre. close() ne bloque donc pas sur un
/// effectif restant (même raisonnement que LayerBatchesService.close()).
model BreederBatch {
  id     String @id @default(uuid())
  farmId String
  /// Auto-généré, format REP-AAAA-NNN, retry P2002 — pattern
  /// CustomersService.generateCode.
  code   String

  strain           String?
  constitutionDate DateTime
  femaleCount      Int
  maleCount        Int

  buildingId       String
  primaryManagerId String

  status       BreederBatchStatus @default(ACTIF)
  observations String?            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  farm              Farm                 @relation(fields: [farmId], references: [id])
  building          Building             @relation(fields: [buildingId], references: [id])
  primaryManager    User                 @relation("BreederBatchPrimaryManager", fields: [primaryManagerId], references: [id])
  dailyRecords      BreederDailyRecord[]
  incubationBatches IncubationBatch[]
  expenses          Expense[]

  @@unique([farmId, code])
  @@index([farmId])
  @@index([farmId, status])
  @@map("breeder_batches")
}

/// Créé à la demande (comme LayerDailyRecord) — reproducteurs à cycle
/// long, pas de génération en masse. eggsSold = compteur brut, PAS de
/// généralisation Sale/EggStock (le §6.2 ne demande aucun mécanisme de
/// stock/FIFO/calibres pour ces œufs, contrairement au §5.4 pondeuses).
/// Pas de champ eggsTransferredToIncubation persisté : voir
/// BreederBatch — la quantité disponible pour incubation est calculée à
/// la lecture (cumul eggsSelectedForIncubation - cumul IncubationBatch.
/// eggCount déjà consommés pour ce lot), jamais stockée.
model BreederDailyRecord {
  id      String @id @default(uuid())
  farmId  String
  batchId String

  date       DateTime
  operatorId String?

  eggsLaid                  Int
  eggsSelectedForIncubation Int @default(0)
  eggsRejected              Int @default(0)
  eggsSold                  Int @default(0)

  observations String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm     Farm         @relation(fields: [farmId], references: [id])
  batch    BreederBatch @relation(fields: [batchId], references: [id])
  operator User?        @relation("BreederDailyRecordOperator", fields: [operatorId], references: [id])

  @@unique([batchId, date])
  @@index([farmId])
  @@index([batchId, date])
  @@map("breeder_daily_records")
}

enum IncubationBatchStatus {
  EN_INCUBATION
  ECLOS
  CLOTURE
  ANNULEE
}

/// expectedHatchDate/expectedCandlingDate : calculés à la lecture depuis
/// incubationStartDate + Setting (incubation.duration_days=21,
/// incubation.candling_day_offset=7), jamais persistés — même principe
/// que plannedSaleDate vs jalons calendaires en Phase 3.
model IncubationBatch {
  id     String @id @default(uuid())
  farmId String
  /// Auto-généré, format INC-AAAA-NNN, retry P2002.
  code   String

  /// Filiation obligatoire, non contournable.
  breederBatchId String
  incubatorId    String

  incubationStartDate DateTime
  /// Validé en service contre BreederBatch.availableFertileEggs (calculé
  /// à la lecture) — égalité acceptée, pas seulement strictement inférieur.
  eggCount            Int

  actualHatchDate    DateTime?
  eggsInfertile      Int?
  eggsInfected       Int?
  embryonicMortality Int?
  chicksHatched      Int?
  remarks            String?   @db.Text

  status IncubationBatchStatus @default(EN_INCUBATION)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  farm         Farm           @relation(fields: [farmId], references: [id])
  breederBatch BreederBatch   @relation(fields: [breederBatchId], references: [id])
  incubator    Incubator      @relation(fields: [incubatorId], references: [id])
  lineageRows  BatchLineage[]
  expenses     Expense[]

  @@unique([farmId, code])
  @@index([farmId])
  @@index([breederBatchId])
  @@index([farmId, status])
  @@map("incubation_batches")
}

enum ChickBatchPurpose {
  VENTE
  RENOUVELLEMENT
}

enum ChickBatchStatus {
  ACTIF
  CLOTURE
  ANNULE
}

/// N'existe QUE pour les destinations VENTE et RENOUVELLEMENT (§6.5 :
/// "Vente poussins -> création d'un STOCK" vs "Chair -> création d'une
/// nouvelle BANDE", verbes différents délibérément — la destination chair
/// réutilise directement BroilerBatch, jamais de ChickBatch intermédiaire,
/// voir orientation.service.ts). Pas de CREATE direct exposé : naît
/// toujours d'une orientation.
model ChickBatch {
  id     String @id @default(uuid())
  farmId String
  /// Auto-généré, format POU-AAAA-NNN, retry P2002.
  code   String

  purpose         ChickBatchPurpose
  initialQuantity Int
  /// Requis en service SI purpose=RENOUVELLEMENT (housing nécessaire pour
  /// l'élevage), optionnel sinon (stock en attente de vente).
  buildingId      String?

  status ChickBatchStatus @default(ACTIF)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  farm     Farm      @relation(fields: [farmId], references: [id])
  building Building? @relation(fields: [buildingId], references: [id])
  sales    Sale[]
  expenses Expense[]

  @@unique([farmId, code])
  @@index([farmId])
  @@map("chick_batches")
}

enum ChickTransformationType {
  VENTE
  CHAIR
  RENOUVELLEMENT
  REFORME_PERTE
}

/// Polymorphisme ASYMÉTRIQUE (décision retenue après revue) :
/// incubationBatchId = FK dure, PAS parentType/parentId — dans le
/// périmètre réellement construit par cette phase, un seul type de parent
/// existe jamais ("lot d'œufs fécondés" et "lot de poussins" ne sont
/// volontairement pas matérialisés comme entités, voir BreederDailyRecord/
/// ChickBatch) ; un champ "polymorphe" à valeur unique observable serait
/// une indirection sans bénéfice, contraire à "relations explicites"
/// (BASE_DE-DONNEES.md). childType/childId, eux, restent réellement
/// polymorphes (2 types d'entité enfant + un cas terminal sans enfant
/// pour REFORME_PERTE, choisis à l'exécution selon transformationType) —
/// même style que Document.entityType/entityId. Une même incubation peut
/// produire PLUSIEURS lignes d'orientation (§16-D), donc une vraie table
/// de lignes, pas des FK scalaires sur IncubationBatch.
model BatchLineage {
  id     String @id @default(uuid())
  farmId String

  incubationBatchId  String
  transformationType ChickTransformationType
  quantity           Int

  /// 'chick_batch' | 'broiler_batch' — null pour REFORME_PERTE.
  childType String?
  childId   String?
  /// Motif, uniquement pour REFORME_PERTE.
  reason    String? @db.Text

  date      DateTime
  createdAt DateTime @default(now())
  createdBy String

  farm            Farm            @relation(fields: [farmId], references: [id])
  incubationBatch IncubationBatch @relation(fields: [incubationBatchId], references: [id])

  @@index([farmId])
  @@index([incubationBatchId])
  @@index([childType, childId])
  @@map("batch_lineage")
}

enum WaterPointStatus {
  ACTIF
  SUSPENDU
  MAINTENANCE
}

/// Entité unique point+compteur (décision Phase 6) — le cahier §12 liste
/// water_points/water_meters séparément, mais §7.1 ne décrit qu'un seul
/// jeu de champs plat ; un compteur n'a ici ni cycle de vie ni mouvements
/// propres (contrairement à EggStockLot, qui justifie sa table séparée
/// par sa logique FIFO). Même règle de décision que Incubator vs Building
/// en Phase 5 : séparer seulement si (a) une 3e table a une FK dure
/// dessus, ou (b) logique métier non triviale à partager — aucun des
/// deux ne s'applique ici. code = EAU-NNN, plat, PAS année-scopée
/// (installation permanente, comme Customer/Supplier — pas un cycle
/// répété comme les codes de bande).
model WaterPoint {
  id     String @id @default(uuid())
  farmId String
  code   String

  name            String
  location        String?
  meterReference  String?
  /// Verrouillé en service dès qu'un WaterReading existe pour ce point —
  /// sinon on pourrait réécrire rétroactivement le point de départ d'une
  /// chronologie d'index déjà validée.
  initialIndex    Decimal @db.Decimal(10, 2)
  /// FCFA/m³. "Tarif par récipient" (§7.1) n'est pas un champ manquant :
  /// déjà couvert par Sale.saleMode=UNITE + Sale.unitPriceFcfa saisi
  /// librement par vente, sans relevé associé.
  tariffFcfaPerM3 Int

  responsibleId String
  status        WaterPointStatus @default(ACTIF)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  farm        Farm           @relation(fields: [farmId], references: [id])
  responsible User           @relation("WaterPointResponsible", fields: [responsibleId], references: [id])
  readings    WaterReading[]
  sales       Sale[]
  expenses    Expense[]

  @@unique([farmId, code])
  @@index([farmId])
  @@map("water_points")
}

/// Une ligne par jour par point (comme BreederDailyRecord/LayerDailyRecord)
/// — pas de deletedAt, pas de DELETE exposé : corrections exclusivement
/// via PATCH, auditées (AuditLogService). Contrairement à Expense/Payment
/// (transactions libres, 0 à N occurrences, deletedAt réel).
model WaterReading {
  id           String @id @default(uuid())
  farmId       String
  waterPointId String

  date       DateTime
  operatorId String?

  indexMatin    Decimal @db.Decimal(10, 2)
  indexSoir     Decimal @db.Decimal(10, 2)
  /// Dérivé à l'écriture (= indexSoir - indexMatin) sauf anomalie
  /// documentée (indexSoir < indexMatin + indexAnomalyReason renseigné) :
  /// dans ce cas, override manuel requis en DTO — jamais un plafond
  /// silencieux à 0 (voir plan Phase 6, section B.1 : effacerait
  /// silencieusement une vraie consommation lors d'un remplacement de
  /// compteur).
  consumptionM3 Decimal @db.Decimal(10, 2)

  /// Snapshot de WaterPoint.tariffFcfaPerM3 au moment du relevé — jamais
  /// recalculé rétroactivement si le tarif change plus tard.
  tariffFcfaPerM3Snapshot Int
  /// Dérivé = consumptionM3 x tariffFcfaPerM3Snapshot.
  theoreticalAmountFcfa   Int
  /// Saisi (comptage de caisse physique) — voir plan Phase 6 section C :
  /// indépendant de Sale(EAU), pas dérivé automatiquement (le
  /// rapprochement théorique/caisse perdrait son sens sinon).
  cashAmountFcfa          Int
  /// Dérivé = cashAmountFcfa - theoreticalAmountFcfa.
  varianceFcfa            Int

  /// Requis si indexSoir < indexMatin OU indexMatin != dernier indexSoir
  /// validé du point (contrôles §7.3, bloqués sinon en 400/409 — voir
  /// service).
  indexAnomalyReason String? @db.Text
  /// Requis (non vide) si varianceFcfa != 0 (§7.3 "tout écart doit être
  /// justifié") — réutilise ce champ déjà listé au §7.2, pas un champ
  /// dédié supplémentaire.
  remarks            String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  farm       Farm       @relation(fields: [farmId], references: [id])
  waterPoint WaterPoint @relation(fields: [waterPointId], references: [id])
  operator   User?      @relation("WaterReadingOperator", fields: [operatorId], references: [id])

  @@unique([waterPointId, date])
  @@index([farmId])
  @@index([waterPointId, date])
  @@map("water_readings")
}

/// Catalogue d'articles — donnée de référence permanente (comme Building/
/// Incubator), PAS de code auto (aucun champ "code article" au §8.1 du
/// cahier, contrairement à Customer/Supplier/WaterPoint). category/unit
/// paramétrables (texte libre), comme Supplier.category.
///
/// currentStock/averageUnitCostFcfa PERSISTÉS — divergence assumée par
/// rapport à la convention constante du projet (tout le reste est dérivé
/// à la lecture : BroilerBatch.currentHeadcount, EggStockLot.remaining,
/// BreederBatch.availableFertileEggs...) : un article générique consommé
/// quotidiennement sur toute la durée de vie de la ferme a un volume de
/// mouvements non borné dans le temps (contrairement à un lot borné à
/// 45-90 jours) — sommer StockMovement à chaque lecture deviendrait
/// coûteux. Compensé par un point d'écriture unique
/// (StockMovementsService.recordMovementInTransaction) : aucun autre
/// service n'écrit ces deux champs directement.
model Item {
  id     String @id @default(uuid())
  farmId String

  name     String
  category String
  unit     String

  minThreshold        Decimal? @db.Decimal(12, 3)
  currentStock        Decimal  @default(0) @db.Decimal(12, 3)
  averageUnitCostFcfa Int      @default(0)

  supplierId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  farm     Farm      @relation(fields: [farmId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  movements           StockMovement[]
  purchaseOrderItems  PurchaseOrderItem[]
  broilerDailyRecords BroilerDailyRecord[] @relation("BroilerDailyRecordFeedItem")
  layerDailyRecords   LayerDailyRecord[]   @relation("LayerDailyRecordFeedItem")
  broilerHealthEvents BroilerHealthEvent[] @relation("BroilerHealthEventItem")
  layerHealthEvents   LayerHealthEvent[]   @relation("LayerHealthEventItem")

  @@index([farmId])
  @@map("items")
}

enum StockMovementType {
  ENTREE
  SORTIE
}

/// ACHAT/RETOUR/AJUSTEMENT/PRODUCTION_INTERNE : réservés à ENTREE.
/// DISTRIBUTION_BANDE/VENTE/PERTE/CASSE/CONSOMMATION_INTERNE : réservés à
/// SORTIE. Un inventaire produisant un surplus/déficit est une ENTREE/
/// SORTIE avec reason=AJUSTEMENT + justification obligatoire — pas un 3e
/// type de mouvement séparé.
enum StockMovementReason {
  ACHAT
  RETOUR
  AJUSTEMENT
  PRODUCTION_INTERNE
  DISTRIBUTION_BANDE
  VENTE
  PERTE
  CASSE
  CONSOMMATION_INTERNE
}

/// Append-only (comme Payment/EggStockMovement) — pas de deletedAt, pas de
/// DELETE/UPDATE exposés : une correction est un mouvement compensatoire
/// inverse avec motif, jamais une édition en place. Écrit EXCLUSIVEMENT
/// via StockMovementsService.recordMovementInTransaction(tx, ...) — tx
/// obligatoire (jamais optionnel), verrouillage SELECT ... FOR UPDATE sur
/// la ligne Item dans la transaction (pattern
/// EggStockService.consumeFifoInternal, seul mécanisme de concurrence
/// réel du projet avant cette phase). unitCostFcfaSnapshot : coût saisi
/// pour ACHAT/PRODUCTION_INTERNE, CUMP courant de l'Item (neutre) pour
/// RETOUR/AJUSTEMENT — jamais recalculé rétroactivement.
model StockMovement {
  id     String @id @default(uuid())
  farmId String
  itemId String

  type   StockMovementType
  reason StockMovementReason

  quantity             Decimal @db.Decimal(12, 3)
  unitCostFcfaSnapshot Int
  totalValueFcfa       Int

  /// Requis si reason=AJUSTEMENT (§15 : "un mouvement de stock doit
  /// toujours avoir une origine métier ou un motif d'ajustement").
  justification String? @db.Text

  /// Traçabilité polymorphe optionnelle de l'origine automatique — comme
  /// Document.entityType/entityId. 'broiler_daily_record'|
  /// 'layer_daily_record'|'broiler_health_event'|'layer_health_event'|
  /// 'goods_receipt'. NULL = mouvement manuel (ajustement/inventaire).
  sourceType String?
  sourceId   String?

  date      DateTime
  createdAt DateTime @default(now())
  createdBy String

  farm Farm @relation(fields: [farmId], references: [id])
  item Item @relation(fields: [itemId], references: [id])

  @@index([farmId])
  @@index([itemId, date])
  @@map("stock_movements")
}

enum PurchaseOrderStatus {
  BROUILLON
  COMMANDE
  PARTIELLEMENT_RECU
  RECU
  ANNULE
}

/// Code auto ACH-AAAA-NNN, retry P2002 (pattern
/// BroilerBatchesService.generateBatchCode). totalAmountFcfa dérivé à
/// l'écriture depuis la somme des lignes. "Facture" (§8.4) = un Document
/// (category="facture") attaché via entityType/entityId — pas de nouvelle
/// entité Invoice (le §12 cible n'en liste d'ailleurs aucune séparément).
model PurchaseOrder {
  id     String @id @default(uuid())
  farmId String
  code   String

  supplierId String
  date       DateTime
  dueDate    DateTime?

  status          PurchaseOrderStatus @default(BROUILLON)
  totalAmountFcfa Int                 @default(0)
  observation     String?             @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  farm             Farm                @relation(fields: [farmId], references: [id])
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  items            PurchaseOrderItem[]
  goodsReceipts    GoodsReceipt[]
  supplierPayments SupplierPayment[]

  @@unique([farmId, code])
  @@index([farmId])
  @@index([farmId, status])
  @@map("purchase_orders")
}

/// receivedQuantity cumulée CALCULÉE À LA LECTURE (somme des
/// GoodsReceiptItem liés), jamais persistée ici — même principe que
/// BreederBatch.availableFertileEggs.
model PurchaseOrderItem {
  id              String @id @default(uuid())
  farmId          String
  purchaseOrderId String
  itemId          String

  orderedQuantity Decimal @db.Decimal(12, 3)
  unitPriceFcfa   Int
  lineAmountFcfa  Int

  farm              Farm               @relation(fields: [farmId], references: [id])
  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  item              Item               @relation(fields: [itemId], references: [id])
  goodsReceiptItems GoodsReceiptItem[]

  @@index([farmId])
  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

/// Chaque GoodsReceiptItem avec receivedQuantity > 0 déclenche un
/// StockMovement ENTREE (reason=ACHAT, sourceType='goods_receipt').
/// Plusieurs GoodsReceiptItem (articles différents) traités dans UNE
/// SEULE transaction : verrouillage trié par itemId (ordre déterministe)
/// pour éviter un deadlock InnoDB entre deux réceptions concurrentes
/// listant les mêmes articles dans un ordre différent.
model GoodsReceipt {
  id              String @id @default(uuid())
  farmId          String
  purchaseOrderId String

  date          DateTime
  responsibleId String
  observation   String?  @db.Text

  createdAt DateTime @default(now())
  createdBy String?

  farm          Farm               @relation(fields: [farmId], references: [id])
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  responsible   User               @relation("GoodsReceiptResponsible", fields: [responsibleId], references: [id])
  items         GoodsReceiptItem[]

  @@index([farmId])
  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String @id @default(uuid())
  farmId              String
  goodsReceiptId      String
  purchaseOrderItemId String

  receivedQuantity Decimal @db.Decimal(12, 3)

  farm              Farm              @relation(fields: [farmId], references: [id])
  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id])
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])

  @@index([farmId])
  @@index([goodsReceiptId])
  @@map("goods_receipt_items")
}

/// Entité SÉPARÉE, PAS une généralisation de Payment (voir plan Phase 7,
/// section G) : Payment.saleId est une FK dure non-nullable et
/// PaymentsService est étroitement couplé à Sale
/// (recomputeSaleStatus/computeSaleStatus, non généralisable tel quel à
/// PurchaseOrder) — le couplage justifie ici la séparation, pas la
/// fusion. Append-only (deletedAt, comme Payment) — solde restant =
/// PurchaseOrder.totalAmountFcfa - SUM(non supprimés), calculé à la
/// lecture. Contrôle "ne peut pas excéder le solde restant" (§15)
/// implémenté dès la création (voir aussi le même correctif appliqué à
/// PaymentsService cette même phase, DETTE_TECHNIQUE.md).
model SupplierPayment {
  id              String @id @default(uuid())
  farmId          String
  purchaseOrderId String

  date        DateTime
  method      String
  amountFcfa  Int
  reference   String?
  observation String?  @db.Text

  createdAt DateTime  @default(now())
  createdBy String?
  deletedAt DateTime?

  farm          Farm          @relation(fields: [farmId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([farmId])
  @@index([purchaseOrderId])
  @@map("supplier_payments")
}
