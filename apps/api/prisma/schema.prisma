// Schéma Prisma — Phase 0 (socle uniquement)
// Tables métier (bandes, ventes, stocks...) ajoutées à partir de la Phase 3.
// Toute table métier future doit porter farmId (isolation multi-tenant).

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 : l'URL de connexion n'est plus déclarée ici mais dans
// prisma.config.ts (CLI/Migrate) et passée explicitement au driver adapter
// lors de l'instanciation de PrismaClient (voir src/prisma/prisma.service.ts).
datasource db {
  provider = "mysql"
}

enum UserStatus {
  /// Compte créé par un admin, en attente d'activation (email non vérifié,
  /// aucun mot de passe défini) — voir POST /users puis POST /auth/activer-compte.
  INVITED
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OauthProvider {
  GOOGLE
  MICROSOFT
}

model Farm {
  id       String  @id @default(uuid())
  name     String
  country  String  @default("CF")
  locality String?
  currency String  @default("XAF")
  timezone String  @default("Africa/Bangui")
  settings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  roles           Role[]
  buildings       Building[]
  auditLogs       AuditLog[]
  settingsEntries Setting[]
  suppliers       Supplier[]
  customers       Customer[]
  documents       Document[]
  alerts          Alert[]
  notifications   Notification[]

  @@map("farms")
}

model User {
  id     String @id @default(uuid())
  farmId String
  email  String
  name   String

  /// Null tant que le compte n'est pas activé (créé par un admin, voir
  /// UserStatus.INVITED) — jamais de mot de passe placeholder inutilisable.
  passwordHash String?
  status       UserStatus @default(INVITED)

  emailVerified              Boolean   @default(false)
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  passwordResetTokenHash     String?
  passwordResetExpiresAt     DateTime?

  twoFactorEnabled Boolean @default(false)
  /// Généré à l'activation 2FA, non utilisé tant que twoFactorEnabled = false.
  twoFactorSecret  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  farm          Farm           @relation(fields: [farmId], references: [id])
  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  oauthAccounts OauthAccount[]
  auditLogs     AuditLog[]     @relation("AuditLogUser")
  notifications Notification[]

  @@unique([farmId, email])
  @@index([farmId])
  @@map("users")
}

/// RBAC piloté par données : les rôles/permissions ne sont jamais un enum figé
/// dans le code, pour absorber les référentiels de rôles à unifier (voir
/// docs/architecture/DONDY_ELEVAGE_GO_PHASE0.md, point B.5).
model Role {
  id       String  @id @default(uuid())
  /// null = rôle système global (isSystem = true) ; renseigné = rôle propre à une ferme
  farmId   String?
  name     String
  isSystem Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  farm            Farm?            @relation(fields: [farmId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([farmId, name])
  @@index([farmId])
  @@map("roles")
}

/// Catalogue système des permissions, non scindé par ferme.
model Permission {
  id          String  @id @default(uuid())
  code        String  @unique
  description String?

  createdAt DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  createdAt DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id                  String    @id @default(uuid())
  userId              String
  tokenHash           String
  expiresAt           DateTime
  revokedAt           DateTime?
  /// Renseigné à la rotation : hash du token émis en remplacement de celui-ci.
  /// Un refresh révoqué mais réutilisé (replacedByTokenHash déjà renseigné)
  /// indique un vol probable — toute la famille de tokens est alors révoquée.
  replacedByTokenHash String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model OauthAccount {
  id                String        @id @default(uuid())
  userId            String
  provider          OauthProvider
  providerAccountId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Building {
  id       String @id @default(uuid())
  farmId   String
  name     String
  type     String
  capacity Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  farm Farm @relation(fields: [farmId], references: [id])

  @@index([farmId])
  @@map("buildings")
}

/// Append-only par convention applicative : jamais de mise à jour du contenu
/// d'une entrée existante. `deletedAt` reste présent pour rester conforme à la
/// convention transversale (finances/santé/audit), réservé à un usage
/// administratif exceptionnel — jamais utilisé par le flux applicatif normal.
model AuditLog {
  id         String  @id @default(uuid())
  farmId     String
  userId     String?
  entityType String
  entityId   String
  action     String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  farm Farm  @relation(fields: [farmId], references: [id])
  user User? @relation("AuditLogUser", fields: [userId], references: [id])

  @@index([farmId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Setting {
  id     String @id @default(uuid())
  farmId String
  key    String
  value  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm Farm @relation(fields: [farmId], references: [id])

  @@unique([farmId, key])
  @@map("settings")
}

/// Donnée de référence (comme Building) : suppression définitive, tracée par
/// AuditLog (oldValues), pas de deletedAt — voir docs/reference/BASE_DE-DONNEES.md,
/// le soft delete est réservé aux données financières/sanitaires/d'audit.
model Supplier {
  id          String  @id @default(uuid())
  farmId      String
  name        String
  /// Catégorie paramétrable : texte libre, volontairement pas un enum figé.
  category    String
  contactName String?
  phone       String?
  address     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  farm Farm @relation(fields: [farmId], references: [id])

  @@index([farmId])
  @@map("suppliers")
}

enum CustomerType {
  PARTICULIER
  COMMERCANT
  RESTAURANT
  REVENDEUR
  ENTREPRISE
  AUTRE
}

/// Donnée de référence (comme Building) : suppression définitive, tracée par
/// AuditLog (oldValues), pas de deletedAt.
model Customer {
  id     String @id @default(uuid())
  farmId String
  /// Auto-généré (ex. "CLI-000123"), dérivé du dernier code émis — voir
  /// CustomersService.generateCode().
  code   String
  /// Couvre "nom/prénom ou raison sociale" en un seul champ libre — `type`
  /// distingue déjà particulier vs entreprise.
  name         String
  phone        String?
  locality     String?
  address      String?
  type         CustomerType @default(AUTRE)
  observations String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  farm Farm @relation(fields: [farmId], references: [id])

  @@unique([farmId, code])
  @@index([farmId])
  @@map("customers")
}

/// Rattachement polymorphe (entityType + entityId, pas de FK Prisma — la
/// cible varie). deletedAt conservé ici (contrairement à Supplier/Customer) :
/// contrairement à une ligne de données, les octets du fichier ne sont
/// reconstructibles depuis aucune autre trace — suppression physique jamais
/// effectuée sur ce chemin, seulement soft-delete de la ligne.
model Document {
  id     String @id @default(uuid())
  farmId String
  entityType String
  entityId   String
  /// Catégorie paramétrable (facture, photo, ordonnance, certificat...),
  /// texte libre comme Supplier.category.
  category String?
  /// Conservé pour affichage uniquement — JAMAIS utilisé pour construire un
  /// chemin sur disque (voir storedName).
  originalName String
  /// Nom UUID réel sur disque, extension dérivée du MIME validé par contenu
  /// (jamais de l'extension fournie par l'utilisateur).
  storedName String
  mimeType   String
  sizeBytes  Int

  createdAt DateTime  @default(now())
  createdBy String?
  deletedAt DateTime?

  farm Farm @relation(fields: [farmId], references: [id])

  @@index([farmId])
  @@index([entityType, entityId])
  @@map("documents")
}

enum AlertSeverity {
  INFO
  VIGILANCE
  IMPORTANT
  CRITIQUE
}

/// Cycle de vie à 3 états — voir alert-state-machine.ts pour les transitions
/// valides (CREATED -> TRIGGERED -> ACKNOWLEDGED, aucune autre).
enum AlertStatus {
  CREATED
  TRIGGERED
  ACKNOWLEDGED
}

model Alert {
  id     String        @id @default(uuid())
  farmId String
  /// Code libre (ex. "tache_en_retard") — les futures règles métier
  /// (mortalité, stock...) ajouteront leurs propres types, pas un enum figé.
  type     String
  severity AlertSeverity
  /// Rattachement polymorphe optionnel : une alerte générique peut ne cibler
  /// aucune entité précise (ex. démo "tâche en retard").
  entityType String?
  entityId   String?
  title      String
  message    String?     @db.Text
  status     AlertStatus @default(CREATED)
  scheduledAt    DateTime?
  triggeredAt    DateTime?
  acknowledgedAt DateTime?
  /// Convention createdBy : string simple sans relation Prisma, comme partout
  /// ailleurs dans ce schéma (Building.createdBy, User.createdBy...).
  acknowledgedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm          Farm           @relation(fields: [farmId], references: [id])
  notifications Notification[]

  @@index([farmId])
  @@index([farmId, status])
  @@index([entityType, entityId])
  @@map("alerts")
}

model Notification {
  id      String  @id @default(uuid())
  farmId  String
  userId  String
  alertId String?
  title   String
  message String? @db.Text
  /// Seul canal cette phase ; champ réservé pour un futur canal email.
  channel String    @default("in_app")
  readAt  DateTime?

  createdAt DateTime @default(now())

  farm  Farm   @relation(fields: [farmId], references: [id])
  user  User   @relation(fields: [userId], references: [id])
  alert Alert? @relation(fields: [alertId], references: [id])

  @@index([farmId])
  @@index([userId, readAt])
  @@map("notifications")
}
