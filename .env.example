# Copier ce fichier en ".env" (jamais committé) et remplacer les valeurs de
# développement par des secrets réels générés localement.
#
# Ports hôte volontairement décalés pour cohabiter avec donexskill-app, déjà
# présent sur cette machine (voir CLAUDE.md) : MySQL 3307, Redis 6380,
# API 3011, Web 3001, Nginx 8080/8443.

# ---- MySQL (conteneur docker-compose.dev.yml) ----
MYSQL_DATABASE=dondy_elevage
MYSQL_USER=dondy_user
MYSQL_PASSWORD=change_me_dev_password
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_HOST_PORT=3307

# ---- Redis (conteneur docker-compose.dev.yml) ----
REDIS_HOST_PORT=6380

# ---- API NestJS ----
API_HOST_PORT=3011
PORT=3000
# Utilisée par les conteneurs api/web (réseau Docker interne : nom de service
# "mysql", port interne 3306 — distinct du port hôte 3307 publié ci-dessus).
# Pour lancer l'API directement sur l'hôte (hors Docker), utiliser
# apps/api/.env avec "localhost:3307" à la place de "mysql:3306".
DATABASE_URL="mysql://dondy_user:change_me_dev_password@mysql:3306/dondy_elevage"
REDIS_URL="redis://redis:6379"
CORS_ORIGINS="http://localhost:3001,http://localhost:8080"

# JWT — à préparer en Phase 0, finalisé en Phase 1 (voir GO PHASE 0).
JWT_ACCESS_SECRET=change_me_generate_a_strong_random_secret
JWT_REFRESH_SECRET=change_me_generate_a_strong_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OAuth — à préparer en Phase 0, finalisé en Phase 1.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# ---- Web Next.js ----
# 3001 = port canonique du projet (voir CLAUDE.md). À ajuster si un autre
# processus occupe déjà ce port sur votre machine (cas réel rencontré en
# développement : voir docs/architecture/README.md, section Risques).
WEB_HOST_PORT=3001
# Optionnelle : si absente, le front peut déduire l'hôte de l'API à partir de
# celui utilisé pour charger la page (pattern à reprendre en Phase 1).
NEXT_PUBLIC_API_URL="http://localhost:8080/api/v1"

# ---- Nginx ----
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
