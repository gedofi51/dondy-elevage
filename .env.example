# Copier ce fichier en ".env" (jamais committé) et remplacer les valeurs de
# développement par des secrets réels générés localement.
#
# Ports hôte volontairement décalés pour cohabiter avec donexskill-app, déjà
# présent sur cette machine (voir CLAUDE.md) : MySQL 3307, Redis 6380,
# API 3011, Web 3001, Nginx 8080/8443, Mailpit 1026/8026.

# ---- MySQL (conteneur docker-compose.dev.yml) ----
MYSQL_DATABASE=dondy_elevage
MYSQL_USER=dondy_user
MYSQL_PASSWORD=change_me_dev_password
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_HOST_PORT=3307

# ---- Redis (conteneur docker-compose.dev.yml) ----
REDIS_HOST_PORT=6380

# ---- Mailpit (conteneur docker-compose.dev.yml — emails de dev interceptés,
# jamais réellement envoyés) ----
MAILPIT_SMTP_HOST_PORT=1026
MAILPIT_WEB_HOST_PORT=8026

# ---- API NestJS ----
API_HOST_PORT=3011
PORT=3000
# Utilisée par les conteneurs api/web (réseau Docker interne : nom de service
# "mysql", port interne 3306 — distinct du port hôte 3307 publié ci-dessus).
# Pour lancer l'API directement sur l'hôte (hors Docker), utiliser
# apps/api/.env avec "localhost:3307" à la place de "mysql:3306".
DATABASE_URL="mysql://dondy_user:change_me_dev_password@mysql:3306/dondy_elevage"
REDIS_URL="redis://redis:6379"
CORS_ORIGINS="http://localhost:3001,http://localhost:8080"

APP_URL="http://localhost:3001"
API_URL="http://localhost:8080/api/v1"

JWT_ACCESS_SECRET=change_me_generate_a_strong_random_secret
JWT_REFRESH_SECRET=change_me_generate_a_strong_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Secret distinct de JWT_ACCESS_SECRET : un token de challenge 2FA compromis
# ne doit jamais pouvoir être réutilisé comme un access token, et inversement.
TWO_FACTOR_CHALLENGE_SECRET=change_me_generate_a_strong_random_secret

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_CALLBACK_URL="http://localhost:8080/api/v1/auth/oauth/google/callback"
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_CALLBACK_URL="http://localhost:8080/api/v1/auth/oauth/microsoft/callback"

# Réseau Docker interne : nom de service "mailpit", port SMTP interne 1025
# (distinct du port hôte 1026 publié ci-dessus).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="DONDY ELEVAGE <no-reply@dondy-elevage.cf>"

# Bootstrap local/dev uniquement — amorce le tout premier compte Super Admin
# (voir apps/api/prisma/seed.ts). Laisser vide pour ne créer aucun compte de
# bootstrap (comportement par défaut, sûr en production).
SEED_SUPER_ADMIN_EMAIL="superadmin@dondy-elevage.cf"
SEED_SUPER_ADMIN_PASSWORD=

# Taille max d'un document téléversé (Mo) — apps/api/storage/documents/, non
# committé. Chemin lui-même non paramétrable : toujours relatif à apps/api,
# identique dans tous les modes d'exécution (Docker, natif, CI).
DOCUMENTS_MAX_UPLOAD_SIZE_MB=10

# ---- Web Next.js ----
# 3001 = port canonique du projet (voir CLAUDE.md). À ajuster si un autre
# processus occupe déjà ce port sur votre machine (cas réel rencontré en
# développement : voir docs/architecture/README.md, section Risques).
WEB_HOST_PORT=3001
# Optionnelle : si absente, le front peut déduire l'hôte de l'API à partir de
# celui utilisé pour charger la page (pattern à reprendre en Phase 1).
NEXT_PUBLIC_API_URL="http://localhost:8080/api/v1"

# ---- Nginx ----
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
